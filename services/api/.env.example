# Doc-Find API Environment Configuration
PROJECT_NAME="Doc-Find API"
API_V1_STR=/api/v1
SECRET_KEY=docfind-insecure-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL
# SQLite default: sqlite:///./docfind.db
# PostgreSQL: postgresql://user:password@localhost:5432/docfind
DATABASE_URL=sqlite:///./docfind.db

# CORS Allowed Origins (comma separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
