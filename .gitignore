# Git ignore for Doc-Find Monorepo

# Temp files
*.tmp
*.temp
temp_*.html

# OS files
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp

# Flutter/Dart
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/build/
apps/mobile/.packages
apps/mobile/.pub/

# Node
node_modules/
dist/
coverage/
apps/admin/node_modules/
apps/admin/dist/
apps/admin/coverage/

# Python
__pycache__/
*.py[cod]
*$py.class
services/api/.venv/
services/api/venv/
services/api/.pytest_cache/
